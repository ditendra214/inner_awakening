# ==============================================================================
# INNER AWAKENING - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

PROJECT_NAME="Inner Awakening Backend"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Security / JWT
SECRET_KEY="inner-awakening-super-secret-production-grade-jwt-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="inner_awakening"
# If running with SQLite for local zero-dependency testing, set USE_SQLITE=True
USE_SQLITE=True
SQLITE_DB_PATH="./inner_awakening.db"

# Redis Cache & PubSub
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# AI / Pose Analysis Service URL
AI_SERVICE_URL="http://localhost:8001"
